[% USE raw %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-open.inc' %]
<title>KohaTour &mdash; Configuration</title>
[% Asset.css("lib/codemirror/codemirror.min.css") | $raw %]
<style>
    .json-editor-wrapper {
        margin: 10px 0;
    }

    .json-editor-wrapper .CodeMirror {
        border: 1px solid #ccc;
        border-radius: 4px;
        height: 400px;
        font-size: 13px;
    }

    #jsonStatus {
        display: none;
        margin: 10px 0;
        padding: 12px;
        border-radius: 4px;
        font-weight: bold;
    }

    .action-toolbar {
        display: flex;
        align-items: center;
        gap: 30px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .action-group {
        display: flex;
        align-items: center;
        gap: 4px;
    }
</style>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body id="plugin_kohatour_configure" class="plugins">
[% WRAPPER 'header.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active=1 %]
            KohaTour
        [% END %]
    [% END %]
[% END %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-12">

            <h1>KohaTour &mdash; Configuration</h1>

            [% IF saved %]
            <div class="alert alert-success">Configuration saved.</div>
            [% END %]
            [% IF reset_done %]
            <div class="alert alert-success">
                &ldquo;Don&rsquo;t ask again&rdquo; has been reset for all machines.
                The tour banner will reappear on the next page load.
            </div>
            [% END %]
            [% IF reset_default %]
            <div class="alert alert-success">Configuration reset to default.</div>
            [% END %]

            <form method="post">
                <input type="hidden" name="class" value="[% CLASS %]" />
                <input type="hidden" name="method" value="[% METHOD %]" />

                <fieldset>
                    <legend>Tour configuration (JSON)</legend>
                    <p>Define your tours and their steps here:</p>

                    <div class="json-editor-wrapper">
                        <textarea name="tour_config" id="tourConfigInput">[% tour_config | html %]</textarea>
                    </div>

                    <div id="jsonStatus"></div>
                </fieldset>

                <div class="action-toolbar">
                    <div class="action-group">
                        <input type="submit" name="save" id="saveBtn" value="Save" class="btn btn-primary" />
                    </div>
                    <div class="action-group">
                        <input type="submit" name="reset_default" value="Reset to default"
                               class="btn btn-default"
                               onclick="return confirm('Really reset to the default configuration? Your current configuration will be lost.');" />
                    </div>
                    <div class="action-group">
                        <input type="button" id="downloadConfig" value="Download configuration" class="btn btn-default" />
                        <input type="button" id="uploadConfig" value="Upload configuration" class="btn btn-default" />
                        <input type="file" id="uploadConfigFile" accept=".json" style="display: none;" />
                    </div>
                    <div class="action-group">
                        <a href="/cgi-bin/koha/plugins/plugins-home.pl" id="cancelBtn" class="btn btn-default">Cancel</a>
                    </div>
                </div>
            </form>

            <fieldset style="margin-top: 40px;">
                <legend>Reset tour reminders</legend>
                <p>
                    When a user clicks <strong>&ldquo;Don&rsquo;t ask again&rdquo;</strong> on a machine,
                    the tour banner is permanently hidden on that machine (stored in the browser&rsquo;s localStorage).
                </p>
                <p>
                    <strong>Reset for all machines:</strong>
                    This button sets a global timestamp in the Koha database.
                    On the next page load, all browsers will detect that their local entry is outdated
                    and show the banner again.
                </p>
                <p>
                    <strong>Reset for a single machine / browser:</strong>
                    Clear the site data in the browser settings (Settings &rarr; Privacy &rarr; Clear site data).
                </p>

                <form method="post" style="margin-top: 1rem;">
                    <input type="hidden" name="class" value="[% CLASS %]" />
                    <input type="hidden" name="method" value="[% METHOD %]" />
                    <button type="submit" name="reset_never" value="1" class="btn btn-warning"
                            onclick="return confirm('Really reset for all machines?');">
                        Reset &ldquo;Don&rsquo;t ask again&rdquo; for all machines
                    </button>
                </form>
            </fieldset>

            <fieldset style="margin-top: 40px;">
                <legend>Documentation</legend>

                <h3>How KohaTour works</h3>
                <p>
                    KohaTour displays a banner on every staff interface page
                    where a tour is configured for the current URL path.
                    Users can start the tour, dismiss it, or hide it permanently.
                </p>

                <h3>JSON structure</h3>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 15%;">Field</th>
                            <th style="width: 50%;">Description</th>
                            <th style="width: 35%;">Example</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>banner</strong></td>
                            <td>Object with the banner UI texts: <code>notification</code>, <code>yes</code>, <code>no</code>, <code>donotask</code>. Change these to translate the banner into your language.</td>
                            <td><code>"banner": { "yes": "Start" }</code></td>
                        </tr>
                        <tr>
                            <td><strong>tours</strong></td>
                            <td>Array of all tours. Each tour is assigned to a specific page.</td>
                            <td><code>"tours": [{ ... }, { ... }]</code></td>
                        </tr>
                        <tr>
                            <td><strong>path</strong></td>
                            <td>URL path of the target page (without query parameters). Must match <code>window.location.pathname</code> exactly.</td>
                            <td><code>"/cgi-bin/koha/mainpage.pl"</code></td>
                        </tr>
                        <tr>
                            <td><strong>name</strong></td>
                            <td>A descriptive name for the tour (currently only shown in the configuration).</td>
                            <td><code>"Acquisitions introduction"</code></td>
                        </tr>
                        <tr>
                            <td><strong>steps</strong></td>
                            <td>Array of individual tour steps. Each step highlights an element on the page.</td>
                            <td><code>"steps": [{ ... }]</code></td>
                        </tr>
                        <tr>
                            <td><strong>xpath</strong></td>
                            <td>XPath expression that identifies the target element on the page. Easiest to obtain via browser DevTools (see below).</td>
                            <td><code>"//*[@id='navmenulist']"</code></td>
                        </tr>
                        <tr>
                            <td><strong>title</strong></td>
                            <td>Heading of the tour step (shown bold in the popover).</td>
                            <td><code>"Main navigation"</code></td>
                        </tr>
                        <tr>
                            <td><strong>body</strong></td>
                            <td>Description text of the tour step.</td>
                            <td><code>"The navigation menu gives you access to all modules."</code></td>
                        </tr>
                    </tbody>
                </table>

                <h3>Finding the page path</h3>
                <p>
                    The <code>path</code> field must match the page&rsquo;s URL path exactly.
                    To find it, open the target page, press <strong>F12</strong> to open DevTools,
                    switch to the <strong>Console</strong> tab, and type:
                </p>
                <pre style="background:#f5f5f5; padding:8px 12px; border:1px solid #ddd; border-radius:4px; display:inline-block;"><code>window.location.pathname</code></pre>
                <p style="margin-top:8px;">
                    The output (e.g. <code>/cgi-bin/koha/mainpage.pl</code>) is the value to use in the <code>"path"</code> field.
                </p>

                <h3>Finding the XPath</h3>
                <ol>
                    <li>Open the target page in the browser</li>
                    <li>Right-click the desired element &rarr; <strong>Inspect</strong></li>
                    <li>In the DevTools panel: right-click the highlighted HTML tag &rarr; <strong>Copy</strong> &rarr; <strong>Copy XPath</strong></li>
                    <li>Paste the XPath into the configuration under <code>"xpath"</code></li>
                </ol>

                <h3>Important notes</h3>
                <ul>
                    <li><strong>Back up your configuration regularly.</strong> Use &ldquo;Download configuration&rdquo; before making changes or updating the plugin.</li>
                    <li><strong>Disable instead of uninstall.</strong> Uninstalling the plugin deletes the stored configuration. Set the plugin to &ldquo;Disabled&rdquo; instead.</li>
                    <li><strong>JSON validation.</strong> The status bar below the editor shows whether the JSON syntax is valid. The Save button is disabled when there are errors.</li>
                </ul>
            </fieldset>

        </div>
    </div>
</div>

[% MACRO jsinclude BLOCK %]

[% Asset.js("lib/codemirror/codemirror.min.js") | $raw %]
[% Asset.js("lib/codemirror/javascript.min.js") | $raw %]

<script>
(function() {
    var textarea = document.getElementById('tourConfigInput');
    var jsonStatus = document.getElementById('jsonStatus');
    var saveBtn = document.getElementById('saveBtn');

    var editor = CodeMirror.fromTextArea(textarea, {
        mode: "application/json",
        lineNumbers: true,
        lineWrapping: true,
        matchBrackets: true,
        autoCloseBrackets: true,
        indentUnit: 2,
        tabSize: 2,
        indentWithTabs: false
    });

    function validateJSON() {
        var value = editor.getValue();
        try {
            JSON.parse(value);
            jsonStatus.style.display = 'block';
            jsonStatus.style.backgroundColor = '#d4edda';
            jsonStatus.style.color = '#155724';
            jsonStatus.style.border = '1px solid #c3e6cb';
            jsonStatus.innerHTML = '&#10003; JSON is valid';
            saveBtn.disabled = false;
        } catch (e) {
            jsonStatus.style.display = 'block';
            jsonStatus.style.backgroundColor = '#f8d7da';
            jsonStatus.style.color = '#721c24';
            jsonStatus.style.border = '1px solid #f5c6cb';
            jsonStatus.innerHTML = '&#10007; JSON error: ' + e.message;
            saveBtn.disabled = true;
        }
    }

    var originalContent = editor.getValue();
    var isDirty = false;

    function markDirty() {
        isDirty = (editor.getValue() !== originalContent);
    }

    editor.on('change', function() {
        editor.save();
        markDirty();
        validateJSON();
    });

    document.getElementById('downloadConfig').addEventListener('click', function() {
        var blob = new Blob([editor.getValue()], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'kohatour-config.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    });

    var uploadBtn = document.getElementById('uploadConfig');
    var uploadFile = document.getElementById('uploadConfigFile');

    uploadBtn.addEventListener('click', function() {
        uploadFile.click();
    });

    uploadFile.addEventListener('change', function() {
        var file = this.files[0];
        if (!file) return;

        var reader = new FileReader();
        reader.onload = function(e) {
            editor.setValue(e.target.result);
            markDirty();
            validateJSON();
        };
        reader.readAsText(file);
        this.value = '';
    });

    document.getElementById('cancelBtn').addEventListener('click', function(e) {
        if (isDirty) {
            if (!confirm('You have unsaved changes. Are you sure you want to leave?')) {
                e.preventDefault();
            }
        }
    });

    validateJSON();
})();
</script>

[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
